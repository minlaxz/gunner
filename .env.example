# Repository the runner registers to.
REPO_URL=https://github.com/<owner>/<repo>
# Comma-separated. Workflows target the runner with runs-on: [self-hosted, <label>].
LABELS=spai-build
RUNNER_NAME_PREFIX=gunner
# repo or org
RUNNER_SCOPE=repo

# Long-lived: fine-grained PAT, resource owner = repo owner, repository access =
# this repo only, Repository permissions -> Administration: Read and write.
ACCESS_TOKEN=
# Short-lived alternative for smoke tests (expires after 1 hour):
#   gh api -X POST repos/<owner>/<repo>/actions/runners/registration-token --jq .token
RUNNER_TOKEN=
