# Repository the runner registers to. One runner directory per repository.
REPO_URL=https://github.com/<OWNER>/<REPO>
# Comma-separated custom labels. Workflows target the runner with
# runs-on: [self-hosted, <label>]. Name it after the job type, not the host.
LABELS=myapp-build
# Prefix of the runner name shown in GitHub; a random suffix is added per registration.
RUNNER_NAME_PREFIX=myapp
# repo or org
RUNNER_SCOPE=repo

# Long-lived: fine-grained PAT, resource owner = owner of <REPO>, repository access =
# <REPO> only, Repository permissions -> Administration: Read and write.
ACCESS_TOKEN=
# Short-lived alternative for smoke tests (expires after 1 hour):
#   gh api -X POST repos/<OWNER>/<REPO>/actions/runners/registration-token --jq .token
RUNNER_TOKEN=
